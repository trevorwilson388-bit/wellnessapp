<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- App Header -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="8dp"
            app:cardCornerRadius="20dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="#4CAF50">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Health &amp; Wellness"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:textAlignment="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your journey to better health starts here"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:layout_marginTop="8dp"
                    android:textAlignment="center"
                    android:alpha="0.9" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Ad Banner -->
        <com.google.android.gms.ads.AdView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/adview"
            android:layout_marginBottom="12dp"
            app:adSize="BANNER"
            app:adUnitId="ca-app-pub-3940256099942544/6300978111" />

        <!-- Navigation Cards Grid -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Explore"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp" />

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="6dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="0dp">

                <Button
                    android:id="@+id/healthy_recipes"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minHeight="100dp"
                    android:padding="16dp"
                    android:text="🍲\nHealthy Recipes"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:background="@android:color/transparent" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="6dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="0dp">

                <Button
                    android:id="@+id/nutrition_advice"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minHeight="100dp"
                    android:padding="16dp"
                    android:text="🥗\nNutrition Advice"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:background="@android:color/transparent" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="6dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="0dp">

                <Button
                    android:id="@+id/mediton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minHeight="100dp"
                    android:padding="16dp"
                    android:text="🧘\nMeditation"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:background="@android:color/transparent" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="6dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="0dp">

                <Button
                    android:id="@+id/hydration_alert"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minHeight="100dp"
                    android:padding="16dp"
                    android:text="💧\nHydration"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:background="@android:color/transparent" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="6dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="0dp">

                <Button
                    android:id="@+id/start_exercise"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minHeight="100dp"
                    android:padding="16dp"
                    android:text="🏋️\nExercise"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:background="@android:color/transparent" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="6dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="0dp">

                <Button
                    android:id="@+id/daily_motivation"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minHeight="100dp"
                    android:padding="16dp"
                    android:text="💡\nMotivation"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:background="@android:color/transparent" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Shop Card (full width) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            app:cardElevation="6dp"
            app:cardCornerRadius="16dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="#FFF3E0">

            <Button
                android:id="@+id/shop_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minHeight="80dp"
                android:padding="20dp"
                android:text="🛒\nWellness Shop"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#E65100"
                android:background="@android:color/transparent" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
